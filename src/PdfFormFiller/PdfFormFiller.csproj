<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PdfFormFiller</RootNamespace>
    <PackageId>PdfFormFiller</PackageId>
    <Version>0.6.1</Version>
    <Description>Fill, flatten, merge and trim AcroForm PDFs. Self-contained, no third-party dependencies.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- PdfFormFiller.Reports uses internals; see the note in its project file -->
  <ItemGroup>
    <InternalsVisibleTo Include="PdfFormFiller.Reports" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\LiberationSans-Regular.ttf" LogicalName="PdfFormFiller.Fonts.LiberationSans-Regular.ttf" />
  </ItemGroup>

  <!-- The font is embedded in the assembly, so its SIL OFL license text must ship with the package -->
  <ItemGroup>
    <None Include="Fonts\LICENSE-LiberationSans.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
