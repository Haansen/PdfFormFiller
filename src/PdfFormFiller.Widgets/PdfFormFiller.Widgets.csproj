<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PdfFormFiller.Widgets</RootNamespace>
    <PackageId>PdfFormFiller.Widgets</PackageId>
    <Version>0.6.1</Version>
    <Description>Widget-style form API (PdfDocument, PdfFormWidget, PdfTextBoxFieldWidget ...) on top of PdfFormFiller, for code that works with typed field objects.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfFormFiller\PdfFormFiller.csproj" />
  </ItemGroup>

</Project>
